<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="700.0" prefHeight="500.0"
            style="-fx-background-color: #ecf0f1;">

    <top>
        <HBox fx:id="headerBox" spacing="10" alignment="CENTER_LEFT"
              style="-fx-background-color: #2c3e50; -fx-background-radius: 6;">
            <padding>
                <Insets top="12.0" right="16.0" bottom="12.0" left="16.0"/>
            </padding>
            <children>
                <Label fx:id="titleLabel" text="Your Cart"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="closeButton" text="Close"
                        style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-radius: 4; -fx-text-fill: white; -fx-padding: 4 10;"/>
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent;">
            <content>
                <VBox fx:id="itemsContainer" spacing="8">
                    <padding>
                        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <VBox spacing="8">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>
            <children>
                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <Label text="Subtotal:"/>
                    <Label fx:id="labelSubtotal" text="0"/>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <Label fx:id="labelVatText" text="VAT:"/>
                    <Label fx:id="labelVAT" text="0"/>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <Label text="Total:" style="-fx-font-weight: bold;"/>
                    <Label fx:id="labelAmount" text="0" style="-fx-font-weight: bold;"/>
                </HBox>

                <HBox alignment="CENTER_RIGHT">
                    <Button fx:id="placeOrderButton" text="Place Order"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 16; -fx-background-radius: 5;"/>
                </HBox>
            </children>
        </VBox>
    </bottom>

</BorderPane>


