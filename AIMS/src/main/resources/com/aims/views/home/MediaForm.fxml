<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="10"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      prefWidth="200.0" maxWidth="200.0" minWidth="200.0"
      prefHeight="320.0" maxHeight="320.0"
      style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);"
      alignment="CENTER">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <children>
        <ImageView fx:id="mediaImage"
                   fitWidth="170" fitHeight="160"
                   preserveRatio="true"
                   style="-fx-background-color: #ecf0f1; -fx-background-radius: 5;"/>

        <Label fx:id="mediaTitle"
               wrapText="true"
               prefHeight="40.0" maxHeight="40.0"
               maxWidth="170.0"
               style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

        <Label fx:id="mediaPrice"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>

        <Label fx:id="mediaAvail"
               style="-fx-font-size: 10px;"/>

        <Spinner fx:id="quantitySpinner" prefWidth="120.0"/>

        <Button fx:id="addToCartBtn" text="Add to Cart"
                maxWidth="1.7976931348623157E308"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 15; -fx-background-radius: 5;"/>
    </children>
</VBox>


