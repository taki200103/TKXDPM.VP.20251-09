<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root"
      spacing="10" alignment="CENTER_LEFT"
      style="-fx-background-color: #ecf0f1;"
      prefWidth="400.0" prefHeight="220.0">

    <padding>
        <Insets top="15.0" right="20.0" bottom="15.0" left="20.0"/>
    </padding>

    <children>
        <Label text="Additional Information"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <Label text="Preferred delivery time (hh:mm)"/>
        <TextField fx:id="deliveryTime" promptText="e.g. 14:30"/>

        <Label text="Delivery instructions"/>
        <TextField fx:id="deliveryInstructions" promptText="Leave at door, call on arrival..."/>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <children>
                <Button fx:id="cancelButton" text="Cancel"/>
                <Button fx:id="saveButton" text="Save"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
            </children>
        </HBox>
    </children>
</VBox>


