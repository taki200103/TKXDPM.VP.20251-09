<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:id="rootPane"
            prefWidth="600.0" prefHeight="400.0"
            style="-fx-background-color: #ecf0f1;">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-background-color: #2c3e50; -fx-background-radius: 6;">
            <padding>
                <Insets top="10.0" right="16.0" bottom="10.0" left="16.0"/>
            </padding>
            <children>
                <Label fx:id="screenTitle" text="Delivery Information"
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            </children>
        </HBox>
    </top>

    <center>
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets top="15.0" right="20.0" bottom="15.0" left="20.0"/>
            </padding>

            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="120.0"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <children>
                <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="name" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Phone:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="phone" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Address:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="address" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Email:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="email" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="City:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <ComboBox fx:id="province" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Instructions:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="instructions" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            </children>
        </GridPane>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/>
            </padding>
            <children>
                <Button fx:id="cancelButton" text="Cancel"/>
                <Button fx:id="btnConfirmDelivery" text="Confirm"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 16; -fx-background-radius: 5;"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>


