<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aims.views.result.ResultScreenHandler">
    <children>
        <VBox alignment="CENTER" layoutX="100.0" layoutY="50.0" prefHeight="300.0" prefWidth="400.0" spacing="25.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="50.0">
            <children>
                <StackPane>
                    <Circle fill="#3498db" radius="40.0" stroke="WHITE" strokeType="INSIDE" strokeWidth="3.0" />
                    <Label text="✓" textFill="WHITE">
                        <font>
                            <Font name="System Bold" size="40.0" />
                        </font>
                    </Label>
                </StackPane>

                <Label fx:id="resultLabel" text="KẾT QUẢ GIAO DỊCH" textAlignment="CENTER">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>

                <Label fx:id="messageLabel" text="Hệ thống đang xử lý thông tin..." textAlignment="CENTER" wrapText="true">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>

                <Button fx:id="okButton" mnemonicParsing="false" prefHeight="45.0" prefWidth="150.0"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 25; -fx-cursor: hand;"
                        text="OK">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </children>
</AnchorPane>