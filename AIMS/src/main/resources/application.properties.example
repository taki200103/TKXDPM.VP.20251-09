# server port for embedded Tomcat
server.port=8080

# PayPal sandbox config
paypal.mode=sandbox
paypal.clientId=YOUR_SANDBOX_CLIENT_ID
paypal.clientSecret=YOUR_SANDBOX_CLIENT_SECRET

# VietQR test environment config
# Get these from VietQR after registration https://vietqr.vn/merchant/request
vietqr.username=customer-vietqrtest-user2468
vietqr.password=customer-vietqrtest-user2468=
vietqr.apiUrl=https://dev.vietqr.org/vqr/api

# VietQR bank account info for receiving payments
# accountNo = bankAccount (account number)
# accountName = userBankName (account holder name, no diacritics)
# bankCode = bank code (e.g., "MB" for Military Bank, "970415" for VietinBank)
vietqr.accountNo=9704198526191432198
vietqr.accountName=NGUYEN VAN A
vietqr.bankCode=970415

# Email SMTP configuration for sending payment confirmation emails
# For Gmail, you need to use an App Password, not your regular password
# To create an App Password:
# 1. Go to your Google Account settings (https://myaccount.google.com/)
# 2. Enable 2-Step Verification (if not already enabled)
# 3. Go to App Passwords (https://myaccount.google.com/apppasswords)
# 4. Generate a new app password for "Mail"
# 5. Use that 16-character password here (without spaces)
# For other email providers, check their SMTP settings
email.sender=your-email@gmail.com
email.password=your-app-password-here
# Optional: SMTP host (default: smtp.gmail.com)
# email.smtp.host=smtp.gmail.com
# Optional: SMTP port (default: 587)
# email.smtp.port=587